# Supabase > Project Settings > API Keys
# URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) ใช้ในเบราว์เซอร์ได้
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key (sb_secret_...) ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# สุ่มยาว ๆ เช่น: openssl rand -base64 32  (Vercel Cron จะส่งค่านี้มาเอง)
CRON_SECRET=change-me

# ไม่บังคับ: โดเมนอื่นที่อนุญาตให้ส่งคำขอ เช่น https://play.example.com (คั่นด้วย ,)
ALLOWED_ORIGINS=
