# จาก Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# สุ่มยาว ๆ เช่น: openssl rand -base64 32  (Vercel Cron จะส่งค่านี้มาเอง)
CRON_SECRET=change-me

# ไม่บังคับ: โดเมนอื่นที่อนุญาตให้ส่งคำขอ เช่น https://play.example.com (คั่นด้วย ,)
ALLOWED_ORIGINS=
